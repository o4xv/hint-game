{
  "name": "hint-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && cross-env RECONNECT_GRACE_MS=250 ROUND_ADVANCE_MS=900 READY_ADVANCE_MS=80 node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "express": "^5.2.1",
    "posthog-node": "^5.47.2",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "@hint/contracts": "file:../shared",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.20.0"
  }
}
